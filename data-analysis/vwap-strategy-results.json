{
  "command": "cargo run --release -p pm-backtest -- run --config /tmp/pmbot-vwap-compare.toml --strategy mid,vwap --fill-model base,pessimistic --lag 1 --threads 4 --out backtests/vwap3-two-phase-2026-10-28",
  "comparison_config_toml": "# Live test of mix_10c_pre_15c_live_inv (plans/10-strategy-research.md): quotes at others'\n# mid \u00b1 10\u00a2 pre-match, widening to \u00b1 15\u00a2 from 5 minutes before the scheduled start and\n# through play, inventory capped at 3. Size 1, the same tight limits as pmbot-m3-live.toml.\n#\n#   cargo build --release -p pm-live\n#   ./target/release/pmbot --mode live --config config/pmbot-two-phase-live.toml --ui 127.0.0.1:8787\n\n[markets]\ntypes = [\"darts_match_winner\"]\n\n[strategies.mid]\nkind = \"two_phase\"\nsize = 1.0\npre_half_spread = 0.10\nlive_half_spread = 0.15\nwiden_before_start_s = 900.0    # switch to 15\u00a2 15 minutes before the scheduled start\nmax_spread = 0.40\nmax_inventory = 4.0             # at |position| >= 4, quote only the reducing side\nskew_per_contract = 0.01\n\n[strategies.off]\nkind = \"off\"\n\n[risk]\nmax_position = 8.0\nmax_order_size = 2.0\nmax_orders_total = 40\nmax_market_loss = 6.0\nmax_account_loss = 30.0\ndaily_loss_limit = 15.0         # below max_account_loss, so the daily kill fires first\nmarket_loss_limit = 2.0\nmax_dev_from_fair = 0.16    # \u00b115\u00a2 quotes round outward to the tick, up to 15.5\u00a2 from fair\n\n[execution]\nrate_limit_enabled = false    # local REST budget off; HTTP 429 backoff still applies\ncore_spin_us = 1000000        # experiment: core thread never sleeps (one CPU busy); 0 restores sleeping\n\n[strategies.vwap]\nkind = \"two_phase_vwap\"\nsize = 1.0\npre_half_spread = 0.10\nlive_half_spread = 0.15\nwiden_before_start_s = 900.0    # switch to 15\u00a2 15 minutes before the scheduled start\nmax_spread = 0.40\nmax_inventory = 4.0             # at |position| >= 4, quote only the reducing side\nskew_per_contract = 0.01\n\n",
